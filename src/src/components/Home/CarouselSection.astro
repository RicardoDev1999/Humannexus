---
import Carousel from "@components/Carousel.astro";

const { homeStory } = Astro.props;

const homeInitialCarousel = homeStory.content.carousel[0];
const showArrows = homeInitialCarousel.showArrows;
const showSliders= homeInitialCarousel.showSliders;
const items = homeInitialCarousel.items;

---
<section class="w-full m-auto p-1 md:w-10/12 md:p-0 lg:w-8/12">
    <Carousel items={items} showArrows={showArrows} showSliders={showSliders} />
</section>
