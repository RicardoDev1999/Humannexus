---
import HomeCard from "@components/HomeCard.astro";

const { context } = Astro.params;

const { homeStory } = Astro.props;

const scheduleCard =
  homeStory?.content?.schedule_card?.length > 0
    ? homeStory.content.schedule_card[0]
    : null;
---

{
  scheduleCard && (
    <section class="w-full m-auto p-1 md:w-10/12 md:p-0">
      <form
        action={context ? `${context}/contacts` : "/contacts"}
        method="get"
        data-astro-reload
      >
        <input type="hidden" name="ref" value="schedule" />
        <HomeCard
          title={scheduleCard.title}
          description={scheduleCard.description}
          buttonText={scheduleCard.button}
        />
      </form>
    </section>
  )
}
