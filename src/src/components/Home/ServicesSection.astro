---
import { Image } from "astro:assets";
import Button from "../Button.astro";

import { useStoryblokApi } from "@storyblok/astro";
import { getStories } from "../../scripts/astro/services";

const asParam = Astro.url.searchParams.get("as")! || "";
const isStudio = asParam === "studio";

const { homeStory } = Astro.props;

const servicesIds = homeStory?.content?.services || [];

let servicesStories = [];

try {
  const storyblokApi = useStoryblokApi();
  servicesStories = await getStories(
    storyblokApi,
    { by_uuids: String(servicesIds) },
    isStudio
  );
  servicesStories = servicesStories
    .sort((a, b) => servicesIds.indexOf(a.uuid) - servicesIds.indexOf(b.uuid))
    .splice(0, 4);
  servicesStories.map((service) => {
    if (!service.content?.image) return;
    service.content.image.filename = service.content?.image?.is_external_url
      ? service.content?.image?.filename
      : service.content?.image?.filename + "/m/170x159";
  });
} catch (error) {
  return Astro.redirect("/400");
}
---

<section class="flex justify-center w-full mt-4 mx-auto p-1 md:p-0">
  <div class="w-auto inline-flex flex-col items-center gap-y-9">
    <div class="flex flex-col md:flex-row items-center gap-5">
      {
        servicesStories.map((service) => (
          <a class="relative" href={service.full_slug} data-astro-prefetch>
            <div class="rounded-full shadow-md">
              <button class="flex flex-col w-[170px] h-[159px] bg-gray-200 rounded-xl">
                <Image
                  class="w-full h-full object-center object-cover rounded-xl"
                  src={service.content?.image?.filename}
                  alt={service.name}
                  width="170"
                  height="159"
                  decoding="async"
                  loading="lazy"
                />
              </button>
              <div class="absolute flex opacity-0 hover:opacity-100 backdrop-blur-sm bg-h-800 bg-opacity-50 duration-500 inset-0 z-10 text-center justify-center items-center text-xl text-white font-semibold rounded-xl">
                {service.name}
              </div>
            </div>
          </a>
        ))
      }
    </div>
    <div class="flex w-full justify-end">
      <form action="/services" method="get">
        {isStudio && <input type="hidden" name="as" value="studio" />}
        <Button text="Ver mais" variant="light" />
      </form>
    </div>
  </div>
</section>
