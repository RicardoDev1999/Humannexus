---
import { renderRichText } from "@storyblok/astro";

const { footerStory } = Astro.props;

const footerSections = structuredClone(footerStory?.content?.sections);

footerSections.map((section) => {
  if (!section.icon) return section;
  section.icon.filename = !section.icon.is_external_url
    ? section.icon.filename + "/m/800x800"
    : section.icon.filename;
  return section;
});

const year = new Date().getFullYear();
---

<footer class="mt-auto z-40">
  <div class="bg-h-800">
    <div
      class="grid lg:grid-cols-3 grid-cols-1 mt-12 gap-y-8 gap-x-2 px-6 py-14"
    >
      {
        footerSections.map((section) => (
          <div class="footer--section">
            <img
              class="footer--section-image"
              src={section?.icon?.filename}
              loading="lazy"
            />
            <p class="footer--section-title">{section?.title}</p>
            <div
              class="footer--section-item"
              set:html={renderRichText(section?.text)}
            />
          </div>
        ))
      }
    </div>
    <div
      class="px-4 pb-4 flex flex-col-reverse md:flex-row gap-2 justify-between"
    >
      <span class="text-sm text-white sm:text-center"
        >© {year} - Humannexus - Saúde & Performance Desportiva
      </span>
      <div class="flex flex-col md:flex-row gap-2 justify-between">
        <span class="text-sm text-white sm:text-center"
          ><a class="hover:font-medium" href="/terms-and-conditions"
            >Termos e condições</a
          >
        </span>
        <span class="text-sm text-white sm:text-center">
          <a class="hover:font-medium" href="privacy-policy"
            >Política de privacidade</a
          >
        </span>
      </div>
    </div>
  </div>
</footer>

<style scoped>
  .footer--section {
    @apply flex flex-col justify-self-center text-center;
  }
  .footer--section:first-child {
    @apply lg:justify-self-end;
  }
  .footer--section:last-child {
    @apply lg:justify-self-start;
  }
  .footer--section-image {
    @apply w-16 mb-4 mx-auto;
  }
  .footer--section-title {
    @apply mb-2 text-lg font-semibold text-white;
  }
  .footer--section-item {
    @apply text-sm font-medium text-white;
  }
</style>
