---
import { Image } from "astro:assets";

import { storyblokEditable } from "@storyblok/astro";
import { renderRichText } from "@storyblok/astro";

const { story, blok } = Astro.props;

const image = blok.photo?.filename
  ? blok.photo?.is_external_url
    ? blok.photo.filename
    : blok.photo.filename + "/m/256x256/filters:format(webp):quality(85)"
  : "/default-avatar.png";

const description = renderRichText(blok.description);
---

<main {...storyblokEditable(blok)} class="mx-auto max-w-3xl px-4 py-10">
  <div class="flex flex-col items-center gap-4">
    {
      image && (
        <Image
          class="md:h-64 md:w-64 sm:h-48 sm:w-48 h-36 w-36 rounded-2xl object-cover object-center shadow-lg ring-1 ring-border"
          width="256"
          height="256"
          transition:name={"team-image-" + blok._uid}
          alt={story.name}
          src={image}
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="flex flex-col items-center gap-2">
      <h1 class="page-heading">{story.name}</h1>
      {blok.role && <span class="tag-pill">{blok.role}</span>}
    </div>
    <article
      class="prose prose-md w-full max-w-none rounded-2xl border border-border bg-white p-6 shadow-sm prose-headings:text-h-900 md:p-8 lg:prose-lg"
      set:html={description}
    />
  </div>
</main>
