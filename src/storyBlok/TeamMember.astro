---
import { Image } from "astro:assets";

import { storyblokEditable } from "@storyblok/astro";
import { renderRichText } from "@storyblok/astro";

const { story, blok } = Astro.props;

const image = blok.photo?.filename
  ? blok.photo?.is_external_url
    ? blok.photo.filename
    : blok.photo.filename + "/m/256x256/filters:format(webp):quality(85)"
  : "/default-avatar.png";

const description = renderRichText(blok.description);
---

<main {...storyblokEditable(blok)}>
  <div class="flex flex-col items-center">
    {
      image && (
        <Image
          class="md:w-64 md:h-64 sm:w-48 sm:h-48 w-36 h-36 object-center object-cover rounded-3xl shadow-md shadow-slate-300"
          width="256"
          height="256"
          transition:name={"team-image-" + blok._uid}
          alt={story.name}
          src={image}
          decoding="async"
          loading="lazy"
        />
      )
    }
    <span class="flex mt-4 text-2xl text-h-800 font-semibold">{story.name}</span
    >
    <span class="flex mt-1 text-sm text-h-600 font-light">{blok.role}</span>
    <article
      class="max-w-full m-12 prose prose-md lg:prose-lg prose-headings:text-h-800"
      set:html={description}
    />
  </div>
</main>
