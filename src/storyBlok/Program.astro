---
import { storyblokEditable } from "@storyblok/astro";
import { renderRichText } from "@storyblok/astro";
import { Image } from "astro:assets";

const { story, blok } = Astro.props;

const image = blok.image
  ? blok.image.is_external_url
    ? blok.image.filename
    : blok.image.filename + "/m/640x640/filters:format(webp):quality(85)"
  : null;

//If there isn't a description set then let's use the short description
const descriptionIsEmpty =
  !blok.description || blok.description?.content[0].content === undefined;
const description = renderRichText(
  !descriptionIsEmpty ? blok.description : blok.short_description,
);
---

<section {...storyblokEditable(blok)} class="mx-auto max-w-3xl px-4 py-10">
  <div class="flex flex-col items-center gap-6">
    {
      image && (
        <Image
          class="h-72 w-full max-w-md rounded-2xl object-cover shadow-lg ring-1 ring-border md:h-80"
          transition:name={"program-image-" + blok._uid}
          src={image}
          alt={story.name ?? "Program Image"}
          width={640}
          height={640}
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <h1 class="page-heading">{story.name}</h1>
    <article
      class="prose prose-md w-full max-w-none rounded-2xl border border-border bg-white p-6 shadow-sm prose-headings:text-h-900 md:p-8 lg:prose-lg"
      set:html={description}
    />
  </div>
</section>
