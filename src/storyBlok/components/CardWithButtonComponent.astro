---
import { storyblokEditable } from "@storyblok/astro";

import Button from "@components/Button.astro";

const { blok } = Astro.props;
---

<main {...storyblokEditable(blok)} class="w-full">
  <section class="w-full relative mb-7">
    <div
      class="flex flex-col w-full bg-h-700 p-7 pb-8 pt-5 gap-y-3 rounded-3xl text-white"
    >
      <h1 class="text-2xl font-black">{blok.title}</h1>
      <p class="text-sm font-semibold pb-2">
        {blok.description}
      </p>
    </div>
    <div class="absolute right-3 -bottom-7">
      <Button text={blok.button} redirect={blok.redirect} />
    </div>
  </section>
</main>
