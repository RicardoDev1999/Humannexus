---
import { storyblokEditable } from "@storyblok/astro";
import { renderRichText } from "@storyblok/astro";
import { Image } from "astro:assets";

const { story, blok } = Astro.props;

const image = blok.image
  ? blok.image.is_external_url
    ? blok.image.filename
    : blok.image.filename + "/m/640x640/filters:format(webp):quality(85)"
  : null;

//If there isn't a description set then let's use the short description
const descriptionIsEmpty =
  !blok.description || blok.description?.content[0].content === undefined;
const description = renderRichText(
  !descriptionIsEmpty ? blok.description : blok.short_description,
);
---

<section {...storyblokEditable(blok)}>
  <div class="flex flex-col items-center">
    {
      image && (
        <Image
          class="w-auto lg:h-80 h-auto object-cover rounded-3xl shadow-md shadow-slate-300"
          transition:name={"service-image-" + blok._uid}
          src={image}
          alt={story.name ?? "Service Image"}
          width={640}
          height={640}
        />
      )
    }
    <div class="text-center mt-8 text-2xl text-h-800 font-semibold">
      {story.name}
    </div>
    <article
      class="max-w-full mt-12 prose prose-md lg:prose-lg prose-headings:text-h-800"
      set:html={description}
    />
  </div>
</section>
