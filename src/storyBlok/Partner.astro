---
import { storyblokEditable } from "@storyblok/astro";
import { renderRichText } from "@storyblok/astro";
import { Image } from "astro:assets";

const { story, blok } = Astro.props;

const image = blok.photo
  ? blok.photo.is_external_url
    ? blok.photo?.filename
    : blok.photo?.filename + "/m/640x640/filters:format(webp):quality(85)"
  : null;

const description = renderRichText(blok.description);
---

<main {...storyblokEditable(blok)} class="mx-auto max-w-3xl px-4 py-10">
  <div class="flex flex-col items-center gap-6">
    {
      image && (
        <Image
          class="h-72 w-full max-w-md rounded-2xl object-cover shadow-lg ring-1 ring-border md:h-80"
          src={image}
          alt={story.name ?? "Partner image"}
          width={640}
          height={640}
          transition:name={"partner-" + blok._uid}
        />
      )
    }
    <h1 class="page-heading">{story.name}</h1>
    <article
      class="prose prose-md w-full max-w-none rounded-2xl border border-border bg-white p-6 shadow-sm prose-headings:text-h-900 md:p-8"
      set:html={description}
    />
  </div>
</main>
