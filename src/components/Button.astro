---
const { text, variant, redirect } = Astro.props;
---

{
  redirect?.url ? (
    <a href={redirect.url}>
      <span
        class:list={[
          "flex items-center justify-center w-42.5 h-14 px-3 py-2 rounded-3xl shadow-button hover:brightness-110 hover:shadow-md",
          variant === "light" ? "bg-h-700" : "bg-h-900",
        ]}
      >
        <span class="text-white text-base font-semibold">{text}</span>
      </span>
    </a>
  ) : (
    <button
      type="submit"
      class:list={[
        "flex items-center justify-center w-42.5 h-14 px-3 py-2 rounded-3xl shadow-button hover:brightness-110 hover:shadow-md",
        variant === "light" ? "bg-h-700" : "bg-h-900",
      ]}
    >
      <span class="text-white text-base font-semibold">{text}</span>
    </button>
  )
}
