---
import {
  isShowing,
  currentText,
  currentTitle,
  currentVariant,
  hideDialog,
} from "@stores/ToastStore.js";

const title = currentTitle.value;
const text = currentText.value;
const variant = currentVariant.value;
const showing = isShowing.value;

hideDialog();
---

<main
  id="toast--section"
  class:list={[
    "fixed flex justify-center items-start w-screen h-screen backdrop-blur-md bg-gray-800 bg-opacity-20 transition-opacity ease-in-out duration-300 inset-0 z-30 pointer-events-none",
    showing ? "opacity-100" : "opacity-0",
  ]}
>
  <div
    id="toast"
    class:list={[
      "inline-flex flex-col gap-y-4 mt-24 w-auto mx-auto py-4 px-8 rounded-2xl shadow-xl pointer-events-auto",
      variant === "success" ? "bg-h-600" : "bg-red-600",
    ]}
  >
    <div class="flex flex-row justify-between align-middle">
      <p
        id="toast--title"
        class="text-xl font-bold text-white"
        set:text={title}
      />
      <button
        id="toast--close"
        class="text-xl font-bold text-white"
        type="button">X</button
      >
    </div>
    <p
      id="toast--text"
      class="text-base font-medium text-white"
      set:text={text}
    />
  </div>
</main>

<script is:inline>
  const setupToast = () => {
    const toastSection = document.getElementById("toast--section");
    const toastCloseBt = document.getElementById("toast--close");

    if (!toastSection || !toastCloseBt || toastCloseBt.dataset.bound === "true") return;

    toastCloseBt.dataset.bound = "true";
    toastCloseBt.addEventListener("click", () => {
      toastSection.classList.remove("opacity-100");
      toastSection.classList.add("opacity-0");
    });
  };

  document.addEventListener("astro:page-load", setupToast);
  setupToast();
</script>
