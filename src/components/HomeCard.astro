---
import Button from "./Button.astro";

const { title, description, buttonText } = Astro.props;
---

<main class="relative mb-7">
  <div
    class="flex min-h-52 flex-col justify-between gap-5 rounded-xl bg-h-900 p-6 text-white shadow-lg md:p-8"
  >
    <h2 class="text-2xl font-extrabold leading-tight md:text-3xl">{title}</h2>
    <p class="max-w-prose text-sm font-medium leading-6 text-white">
      {description}
    </p>
  </div>
  <div class="absolute right-5 -bottom-5">
    <Button text={buttonText} />
  </div>
</main>
