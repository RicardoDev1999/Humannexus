---
import Button from "./Button.astro";

const { title, description, buttonText } = Astro.props;
---

<main class="relative mb-7">
  <div
    class="flex flex-col w-auto bg-h-700 p-7 pb-8 pt-5 gap-y-3 rounded-3xl text-white"
  >
    <h1 class="text-2xl font-black">{title}</h1>
    <p class="text-sm font-semibold">
      {description}
    </p>
  </div>
  <div class="absolute right-3 -bottom-7">
    <Button text={buttonText} />
  </div>
</main>
