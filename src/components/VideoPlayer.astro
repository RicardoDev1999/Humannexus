---
interface Props {
    videoSrc: string;
    thumbnailSmall: string;
    thumbnailNormal: string;
    thumbnailLarge: string;
}

const { 
    videoSrc, 
    thumbnailSmall,
    thumbnailNormal,
    thumbnailLarge,
} = Astro.props;

// Calculate sizes based on original image
const baseWidth = 1920; 
const sizes = {
    '0.5x': Math.round(baseWidth * 0.5),
    '1x': baseWidth,
    '2x': baseWidth * 2
};
---

<div class="video-background-container">
    <img 
        src={thumbnailNormal}
        srcset={`
            ${thumbnailSmall} ${sizes['0.5x']}w,
            ${thumbnailNormal} ${sizes['1x']}w,
            ${thumbnailLarge} ${sizes['2x']}w
        `}
        sizes="(max-width: 640px) 50vw,
               (max-width: 1200px) 100vw,
               200vw"
        class="thumbnail-overlay"
        alt="Main page thumbnail"
        aria-hidden="true"
        loading="eager"
        decoding="sync"
    />
    <video
        class="video-background"
        crossorigin="anonymous"
        preload="none"
        muted
        loop
        playsinline
        tabindex="-1"
    >
        <source src={videoSrc} type="video/mp4">
    </video>
</div>

<script>
class VideoBackgroundManager {
    private video: HTMLVideoElement;
    private thumbnail: HTMLImageElement;

    constructor(container: HTMLElement) {
        this.video = container.querySelector('video')!;
        this.thumbnail = container.querySelector('img')!;
        
        this.initializeVideo();
        this.handleResize();
    }

    private initializeVideo() {
        const videoCache = new AbortController();
        
        // Ensure thumbnail is loaded first
        if (this.thumbnail.complete) {
            this.startVideoLoad(videoCache);
        } else {
            this.thumbnail.onload = () => this.startVideoLoad(videoCache);
        }

        // Cleanup on page leave
        window.addEventListener('beforeunload', () => {
            videoCache.abort();
        });

        // Handle mobile autoplay
        document.addEventListener('touchstart', () => {
            this.video.play().catch(console.warn);
        }, { once: true });
    }

    private startVideoLoad(videoCache: AbortController) {
        fetch(this.video.querySelector('source')!.src, {
            signal: videoCache.signal,
        }).then(response => response.blob())
          .then(blob => {
            const url = URL.createObjectURL(blob);
            this.video.src = url;
            
            const source = this.video.querySelector('source');
            if (source) source.remove();
            
            this.video.play().catch(console.warn);
            
            this.video.addEventListener('loadeddata', () => {
                this.thumbnail.classList.add('fade-out');
            });
        }).catch(error => {
            if (error.name === 'AbortError') return;
            console.error('Error caching video:', error);
        });
    }

    private handleResize() {
        // Add blur effect based on screen size
        const updateBlur = () => {
            const width = window.innerWidth;
            let blurAmount;
            
            if (width <= 640) {
                blurAmount = '4px';
            } else if (width <= 1200) {
                blurAmount = '6px';
            } else {
                blurAmount = '8px';
            }
            
            this.thumbnail.style.filter = `blur(${blurAmount})`;
        };

        updateBlur();
        window.addEventListener('resize', updateBlur);
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', () => {
    const containers = document.querySelectorAll('.video-background-container');
    containers.forEach(container => {
        new VideoBackgroundManager(container);
    });
});
</script>

<style>
.video-background-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
}

.thumbnail-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    z-index: 0;
    transition: opacity 0.5s ease-out, filter 0.3s ease-out;
}

.thumbnail-overlay.fade-out {
    opacity: 0;
}

.video-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
}

:global(body) {
    position: relative;
}

:global(main), :global(header), :global(footer) {
    position: relative;
    z-index: 2;
}
</style>