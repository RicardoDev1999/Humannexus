---
interface Props {
    videoSrc: string;
    thumbnailSmall: string;
    thumbnailNormal: string;
    thumbnailLarge: string;
}

const { 
    videoSrc, 
    thumbnailSmall,
    thumbnailNormal,
    thumbnailLarge,
} = Astro.props;

// Calculate sizes based on original image
const baseWidth = 1920; 
const sizes = {
    '0.5x': Math.round(baseWidth * 0.5),
    '1x': baseWidth,
    '2x': baseWidth * 2
};

// Use smallest thumbnail as default for fastest initial load
const defaultThumbnail = thumbnailSmall;

// Detect if mobile to optimize loading strategy
const isMobileOptimized = true; // Will be detected client-side
---

<div class="video-background-container">
    <img 
        src={defaultThumbnail}
        srcset={`
            ${thumbnailSmall} ${sizes['0.5x']}w,
            ${thumbnailNormal} ${sizes['1x']}w,
            ${thumbnailLarge} ${sizes['2x']}w
        `}
        sizes="(max-width: 640px) 100vw,
               (max-width: 1200px) 100vw,
               100vw"
        class="thumbnail-overlay"
        alt="Main page thumbnail"
        aria-hidden="true"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
    />
    <video
        class="video-background"
        crossorigin="anonymous"
        preload="none"
        muted
        loop
        playsinline
        tabindex="-1"
    >
        <source src={videoSrc} type="video/mp4">
    </video>
</div>

<script>
class VideoBackgroundManager {
    private video: HTMLVideoElement;
    private thumbnail: HTMLImageElement;
    private container: HTMLElement;
    private videoStarted: boolean = false;
    private isMobile: boolean;

    constructor(container: HTMLElement) {
        this.container = container;
        this.video = container.querySelector('video')!;
        this.thumbnail = container.querySelector('img')!;
        this.isMobile = window.innerWidth <= 768;
        
        this.setupMobileOptimization();
        this.initializeVideo();
        this.handleResize();
    }

    private setupMobileOptimization() {
        // On mobile, only load video on user interaction or after a delay
        if (this.isMobile) {
            // Add visual indicator
            this.container.style.cursor = 'pointer';
            
            // Optimize thumbnail display for slow networks
            this.optimizeThumbnailLoading();
            
            // Start loading after a short delay without blocking the page
            setTimeout(() => {
                if (!this.videoStarted) {
                    this.startVideoPlayback();
                }
            }, 500);
            
            // Also load on first user interaction
            this.container.addEventListener('click', () => {
                if (!this.videoStarted) {
                    this.startVideoPlayback();
                }
            }, { once: true });
            
        } else {
            // Desktop: load video immediately
            this.initializeVideoLoad();
        }
    }

    private optimizeThumbnailLoading() {
        // Show a low-quality placeholder while thumbnail loads
        const thumbnail = this.thumbnail;
        
        // Create a very small blurred version as placeholder
        thumbnail.style.filter = 'blur(8px)';
        thumbnail.style.willChange = 'filter';
        
        // When thumbnail fully loads, remove blur
        if (thumbnail.complete) {
            thumbnail.style.filter = 'blur(0)';
        } else {
            thumbnail.onload = () => {
                thumbnail.style.filter = 'blur(0)';
                thumbnail.style.transition = 'filter 0.3s ease-out';
            };
        }
    }

    private preloadVideo() {
        // Progressive download without playing
        this.video.src = this.video.querySelector('source')!.src;
        this.video.load();
    }

    private startVideoPlayback() {
        if (!this.videoStarted) {
            this.videoStarted = true;
            this.initializeVideoLoad();
        }
    }

    private initializeVideo() {
        const videoCache = new AbortController();
        
        // Ensure thumbnail is loaded first
        if (this.thumbnail.complete) {
            if (!this.isMobile) {
                this.startVideoLoad(videoCache);
            }
        } else {
            this.thumbnail.onload = () => {
                if (!this.isMobile) {
                    this.startVideoLoad(videoCache);
                }
            };
        }

        // Cleanup on page leave
        window.addEventListener('beforeunload', () => {
            videoCache.abort();
        });

    }

    private initializeVideoLoad() {
        const videoCache = new AbortController();
        
        // Ensure thumbnail is loaded first
        if (this.thumbnail.complete) {
            this.startVideoLoad(videoCache);
        } else {
            this.thumbnail.onload = () => this.startVideoLoad(videoCache);
        }

        // Cleanup on page leave
        window.addEventListener('beforeunload', () => {
            videoCache.abort();
        });
    }

    private startVideoLoad(videoCache: AbortController) {
        // Use streaming instead of downloading entire file
        // This allows playback to start before download completes
        const videoElement = this.video.querySelector('source') as HTMLSourceElement;
        
        if (!videoElement) return;

        // Set video source for streaming playback
        this.video.src = videoElement.src;
        
        // Attempt to play immediately (streaming)
        this.video.play().catch(() => {
            // If autoplay fails, it will play on first interaction
        });
        
        // Monitor when video has buffered enough to fade thumbnail
        this.video.addEventListener('playing', () => {
            this.thumbnail.classList.add('fade-out');
        }, { once: true });

        // Fallback: if video hasn't started after buffering some data
        this.video.addEventListener('canplay', () => {
            if (!this.thumbnail.classList.contains('fade-out')) {
                this.thumbnail.classList.add('fade-out');
            }
        }, { once: true });
    }

    private handleResize() {
        // Add blur effect based on screen size
        const updateBlur = () => {
            const width = window.innerWidth;
            let blurAmount;
            
            if (width <= 640) {
                blurAmount = '4px';
            } else if (width <= 1200) {
                blurAmount = '6px';
            } else {
                blurAmount = '8px';
            }
            
            this.thumbnail.style.filter = `blur(${blurAmount})`;
        };

        updateBlur();
        window.addEventListener('resize', updateBlur);
    }
}

// Initialize on first load and after Astro client-side navigation
const initializeVideos = () => {
    const containers = document.querySelectorAll('.video-background-container');
    containers.forEach(container => {
        const element = container as HTMLElement;
        if (element.dataset.videoInitialized === 'true') return;
        element.dataset.videoInitialized = 'true';
        new VideoBackgroundManager(element);
    });
};

document.addEventListener('DOMContentLoaded', initializeVideos);
document.addEventListener('astro:page-load', initializeVideos);
</script>

<style>
.video-background-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
}

.thumbnail-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    z-index: 0;
    transition: opacity 0.5s ease-out, filter 0.3s ease-out;
}

.thumbnail-overlay.fade-out {
    opacity: 0;
}

.video-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
}

:global(body) {
    position: relative;
}

:global(main), :global(header), :global(footer) {
    position: relative;
    z-index: 2;
}
</style>