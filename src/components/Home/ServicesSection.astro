---
import { Image } from "astro:assets";
import Button from "@components/Button.astro";

import { useStoryblokApi } from "@storyblok/astro";
import { getStories } from "@scripts/astro/services";

import { fullSlugToUri } from "@utils/urlUtils.js";

const { context } = Astro.params;

const { homeStory } = Astro.props;

const servicesIds =
  homeStory?.content?.services?.length > 0 ? homeStory?.content?.services : [];

let servicesMapped = [];

const getServicesMapped = async (storyblokApi) => {
  if (!servicesIds || servicesIds.length === 0) return;

  const services = await getStories(
    storyblokApi,
    { by_uuids: String(servicesIds) },
    context
  );

  servicesMapped = structuredClone(services);

  servicesMapped = servicesMapped
    .sort((a, b) => servicesIds.indexOf(a.uuid) - servicesIds.indexOf(b.uuid))
    .splice(0, 4);

  servicesMapped.map((service) => {
    if (!service.content?.image) return service;
    service.content.image.filename = service.content?.image?.is_external_url
      ? service.content?.image?.filename
      : service.content?.image?.filename + "/m/400x375/filters:format(webp):quality(85)";
    return service;
  });
};

try {
  const storyblokApi = useStoryblokApi();
  await getServicesMapped(storyblokApi);
} catch (error) {
  console.error(error);
}
---

{
  servicesMapped.length > 0 && (
    <section class="flex justify-center w-full mt-4 mx-auto p-1 md:p-0">
      <div class="w-auto inline-flex flex-col items-center gap-y-9">
        <div class="flex flex-col md:flex-row items-center gap-5">
          {servicesMapped.map((service) => (
            <a
              class="relative"
              href={fullSlugToUri(service.full_slug)}
              data-astro-prefetch
            >
              <div class="group relative h-40 w-[170px] overflow-hidden rounded-xl bg-h-900 shadow-md transition duration-300 hover:-translate-y-1 hover:shadow-xl">
                <Image
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  src={service.content?.image?.filename}
                  alt={service?.name ?? ""}
                  width="170"
                  height="159"
                  decoding="async"
                  loading="lazy"
                />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-h-900/90 to-transparent px-4 pb-3 pt-10">
                  <span class="block text-sm font-bold text-white">{service.name}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="flex w-full justify-end">
          <form
            action={context ? `${context}/services` : "/services"}
            method="get"
          >
            <Button text="Ver mais" variant="light" />
          </form>
        </div>
      </div>
    </section>
  )
}
