---
const { title, description } = Astro.props;
---

<section class="hero-glow px-6 py-14 sm:py-16">
  <div
    class="pointer-events-none absolute -top-20 -right-16 h-56 w-56 rounded-full bg-h-500/50 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-16 h-56 w-56 rounded-full bg-h-300/40 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-2xl">
    <span class="eyebrow-bar" aria-hidden="true"></span>
    <h1 class="page-heading">{title}</h1>
    {description && <p class="page-intro mt-3">{description}</p>}
  </div>
</section>
