---
import { Image } from "astro:assets";

const { headerStory } = Astro.props;
const { context } = Astro.params;

const currentPath = Astro.url.pathname;

const isMenuSelected = (path): boolean =>
  currentPath != "/" && currentPath != "/home" && path.endsWith(currentPath);

const logo = headerStory?.content?.image?.filename !== "" 
  ? headerStory?.content?.image?.filename + "/m/fit-in/800x360/filters:format(webp):quality(100)"
  : null;

const { default: facebookIcon } = await import(
  `/icons/facebook.svg?raw`
);
const { default: instagramIcon } = await import(
  `/icons/instagram.svg?raw`
);
const { default: whatsappIcon } = await import(
  `/icons/whatsapp.svg?raw`
);

let headerItems = structuredClone(headerStory?.content?.items);
let colorSchema = headerStory?.content?.color_schema?.[0];

const colorData = colorSchema ? JSON.stringify({
  color900: colorSchema?.color900?.color || 'rgb(0, 104, 56)',
  color800: colorSchema?.color800?.color || 'rgb(0, 148, 68)',
  color700: colorSchema?.color700?.color || 'rgb(38, 164, 96)',
  color600: colorSchema?.color600?.color || 'rgb(43, 182, 115)',
  color500: colorSchema?.color500?.color || 'rgb(191, 233, 213)',
  color400: colorSchema?.color400?.color || 'rgb(217, 217, 217)',
  color300: colorSchema?.color300?.color || 'rgb(197, 197, 198)',
}) : '{}';

---

<nav
  class="sticky top-0 z-50"
  data-humannexus-colors={colorData}
>
  <div
    class="header-surface flex h-20.5 max-w-screen-2xl flex-1 flex-wrap items-center justify-between border-b border-border bg-white/95 px-4 shadow-header backdrop-blur transition-shadow duration-300 lg:mx-auto lg:flex-nowrap lg:px-6"
  >
    <div
      class="inline-flex flex-1 flex-row items-center justify-between w-full"
    >
      <a
        href={headerStory.content.logo_redirect}
        data-astro-reload
        class="inline-flex items-center"
      >
        <Image
          src={logo}
          loading={"eager"}
          class="mr-3 max-h-[4.25rem] max-w-[10rem] transition duration-200 hover:scale-[1.02]"
          alt="Humannexus Logo"
          width="800"
          height="360"
        />
      </a>
      <button
        id="navbar-default-trigger"
        data-collapse-toggle="navbar-default"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg p-2 text-h-900 transition hover:bg-h-500/35 lg:hidden"
        aria-controls="navbar-default"
        aria-expanded="false"
      >
        <span class="sr-only">Abrir o menu</span>
        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"></path>
        </svg>
      </button>
    </div>
    <div
      class="hidden w-full justify-end lg:inline-flex lg:w-auto lg:flex-2 z-40"
      id="navbar-default"
    >
      <ul
        class="flex flex-col items-stretch border-t border-border bg-white py-2 text-sm font-bold lg:flex-row lg:items-center lg:gap-1 lg:border-0 lg:py-0"
      >
        {
          headerItems.map((item) => (
            <li class="flex whitespace-nowrap">
              <a
                href={item.url}
                data-astro-prefetch="hover"
                data-astro-reload={item.isDataReload ? "true" : undefined}
                class:list={[
                  "relative flex min-h-11 w-full items-center px-5 text-ink transition-all duration-200 hover:bg-h-500/35 hover:text-h-900 lg:mx-0.5 lg:w-auto lg:rounded-full lg:px-4",
                  isMenuSelected(item.url)
                    ? "bg-h-500/25 text-h-900 lg:bg-h-900 lg:text-white lg:hover:bg-h-900 lg:hover:text-white"
                    : "",
                ]}
                aria-current={isMenuSelected(item.url) ? "page" : undefined}
              >
                {item.name}
              </a>
            </li>
          ))
        }
        <li
          class="flex items-center justify-center px-5"
        >
          <div class="flex flex-row">
            <a
              href="https://www.facebook.com/Humannexuslda/"
              target="_blank"
              class="social-icon inline-flex h-10 w-10 items-center justify-center rounded-full text-ink transition hover:bg-h-500/35 hover:text-h-900"
            >
              <div
                class="block w-[22px] h-[22px] object-center object-contain bg-transparent"
                set:html={facebookIcon}
                style="opacity:inherit;"
              />
            </a>
            <a
              href="https://www.instagram.com/humannexus.pt/"
              target="_blank"
              class="social-icon inline-flex h-10 w-10 items-center justify-center rounded-full text-ink transition hover:bg-h-500/35 hover:text-h-900"
              ><div
                class="social-icon block w-[22px] h-[22px] object-center object-contain bg-transparent"
                set:html={instagramIcon}
                style="opacity:inherit;"
              />
            </a>
            <a
              href="https://wa.me/939036298"
              class="social-icon inline-flex h-10 w-10 items-center justify-center rounded-full text-ink transition hover:bg-h-500/35 hover:text-h-900"
              ><div
                class="social-icon block w-[22px] h-[22px] object-center object-contain bg-transparent"
                set:html={whatsappIcon}
                style="opacity:inherit;"
              />
            </a>
          </div>
        </li>
        <li
          class="flex items-center justify-center px-5"
        >
          <form action={`/${context ?? "humannexus"}/contacts`} method="get" data-astro-reload>
            <input type="hidden" name="ref" value="pricing" />
            <button
              type="submit"
              class="inline-flex min-h-10 items-center justify-center rounded-full bg-h-900 px-5 py-2 text-xs font-bold text-white transition hover:bg-h-800"
            >
              Preçário
            </button>
          </form>
        </li>
      </ul>
    </div>
  </div>
</nav>

<section
  id="navbar-fade-screen"
  class="pointer-events-none fixed flex items-center justify-center inset-0 w-screen h-screen backdrop-blur-md bg-h-400 bg-opacity-40 transition-opacity ease-in-out duration-500 z-[40] lg:hidden"
  style="opacity: 0"
>
</section>

<script>
  document.addEventListener("astro:page-load", async () => {
    const headerSurface = document.querySelector(".header-surface");
    if (headerSurface && !headerSurface.dataset.stuckBound) {
      headerSurface.dataset.stuckBound = "true";
      const updateStuck = () => headerSurface.classList.toggle("is-stuck", window.scrollY > 4);
      updateStuck();
      window.addEventListener("scroll", updateStuck, { passive: true });
    }

    const { initCollapses, Collapse } = await import("flowbite");

    initCollapses();

    const navbarTrigger = document.getElementById("navbar-default-trigger");
    const navbarFadeScreen = document.getElementById("navbar-fade-screen");
    const navbar = document.getElementById("navbar-default");

    const options = {
      onCollapse: () => {
        navbarFadeScreen.style.opacity = "0";
      },
      onExpand: () => {
        navbarFadeScreen.style.opacity = "100";
      },
    };

    const instanceOptions = {
      id: "navbar-default",
      override: true,
    };

    const collapse = new Collapse(
      navbar,
      navbarTrigger,
      options,
      instanceOptions
    );

    document.querySelectorAll(".social-icon svg path").forEach((e) => {
      e.classList.add("fill-h-900");
    });
  });
</script>
