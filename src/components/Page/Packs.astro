---
import { useStoryblokApi } from "@storyblok/astro";
import { getStories } from "@scripts/astro/services";
import { Image } from "astro:assets";

import SectionIntro from "@components/SectionIntro.astro";
import { fullSlugToUri } from "@utils/urlUtils.js";

let storiesMapped;

const { context } = Astro.params;

try {
  const storyblokApi = useStoryblokApi();
  const stories = await getStories(
    storyblokApi,
    {
      content_type: "pack",
    },
    context
  );

  storiesMapped = structuredClone(stories);

  storiesMapped.map((st) => {
    const image = st.content?.photo ?? st.content?.image;
    if (!image) return st;
    image.filename = image.is_external_url
      ? image.filename
      : image.filename + "/m/800x450/filters:format(webp):quality(85)";
    return st;
  });
} catch (error) {
  return Astro.redirect("/400");
}
---

<SectionIntro
  title="Os nossos packs"
  description="Conjugámos várias sessões e serviços a preços especiais!"
/>
<section
  class="mx-auto mt-10 grid max-w-6xl grid-cols-1 gap-5 px-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
>
  {
    storiesMapped.map((st) => (
      <a
        href={fullSlugToUri(st.full_slug)}
        data-astro-prefetch
        class="group relative overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-border transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:ring-h-700/50 reveal"
      >
        <div class="aspect-4/3 overflow-hidden bg-surface">
          {(st.content.photo ?? st.content.image)?.filename && (
            <Image
              class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
              transition:name={"pack-" + st.content._uid}
              src={(st.content.photo ?? st.content.image)?.filename}
              alt={st.content.name ?? "Pack"}
              width={400}
              height={300}
              widths={[200, 300, 400]}
              sizes="(max-width: 768px) 80vw, (max-width: 1024px) 25vw, 20vw"
              loading="eager"
              fetchpriority="high"
            />
          )}
        </div>
        <h2 class="px-4 py-4 text-center text-base font-extrabold text-h-900">{st.name}</h2>
      </a>
    ))
  }
</section>
