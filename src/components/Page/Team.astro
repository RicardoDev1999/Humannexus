---
import { Image } from "astro:assets";

import { renderRichText, useStoryblokApi } from "@storyblok/astro";
import { getStories } from "@scripts/astro/services";

import SectionIntro from "@components/SectionIntro.astro";
import { fullSlugToUri } from "@utils/urlUtils.js";

let storiesMapped;

const { context } = Astro.params;

try {
  const storyblokApi = useStoryblokApi();
  const stories = await getStories(
    storyblokApi,
    {
      content_type: "team-member",
    },
    context,
  );

  storiesMapped = structuredClone(stories);

  storiesMapped.sort((a, b) => {
    const roleA = a.content?.role?.toUpperCase() || "ZZZ";
    const roleB = b.content?.role?.toUpperCase() || "ZZZ";
    const nameA = a.name?.toUpperCase();
    const nameB = b.name?.toUpperCase();

    if (roleA !== roleB) {
      return roleA < roleB ? -1 : 1;
    }

    if (nameA !== nameB) {
      return nameA < nameB ? -1 : 1;
    }

    return 0;
  });

  storiesMapped.map((st) => {
    if (!st.content?.photo?.filename) return st;
    st.content.photo.filename = st.content?.photo?.is_external_url
      ? st.content?.photo?.filename
      : st.content?.photo?.filename +
        "/m/320x320/filters:format(webp):quality(85)";
    return st;
  });
} catch (error) {
  console.error(error);
  return Astro.redirect("/400");
}
---

<SectionIntro
  title="A nossa equipa"
  description="Vem conhecer a nossa equipa de técnicos especializados!"
/>
<section
  class="mx-auto mt-10 grid max-w-6xl grid-cols-1 gap-5 px-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
>
  {
    storiesMapped.map((st, index) => (
      <a
        class="group relative overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-border transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:ring-h-700/50"
        data-astro-prefetch
        href={fullSlugToUri(st.full_slug)}
      >
        <div class="aspect-square overflow-hidden bg-surface">
          <Image
            class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
            transition:name={"team-image-" + st.content._uid}
            src={st.content?.photo?.filename ?? "/default-avatar.png"}
            alt={st.name ?? "Team Member"}
            width={320}
            height={320}
            widths={[160, 240, 320]}
            sizes="(max-width: 768px) 75vw, (max-width: 1024px) 30vw, 22vw"
            decoding="async"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="flex flex-col items-center gap-1 px-4 py-4">
          <h2 class="text-center text-base font-extrabold text-h-900">{st.name}</h2>
          {st.content?.role && <span class="tag-pill">{st.content.role}</span>}
        </div>
      </a>
    ))
  }
</section>
