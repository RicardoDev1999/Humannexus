---
import { useStoryblokApi } from "@storyblok/astro";
import { getStories } from "@scripts/astro/services";
import { Image } from "astro:assets";

import SectionIntro from "@components/SectionIntro.astro";
import { fullSlugToUri } from "@utils/urlUtils.js";

let storiesMapped;

const { context } = Astro.params;

try {
  const storyblokApi = useStoryblokApi();
  const stories = await getStories(
    storyblokApi,
    {
      content_type: "partner",
    },
    context
  );

  storiesMapped = structuredClone(stories);

  storiesMapped.map((st) => {
    if (!st.content?.photo) return st;
    st.content.photo.filename = st.content?.photo?.is_external_url
      ? st.content?.photo?.filename
      : st.content?.photo?.filename + "/m/fit-in/filters:format(webp):quality(85)";
    return st;
  });
} catch (error) {
  return Astro.redirect("/400");
}
---

<SectionIntro
  title="Os nossos parceiros"
  description="Pretendemos fortalecer as relações institucionais e de favorecer a colaboração entre as organizações."
/>
<section
  class="mx-auto mt-10 grid max-w-6xl grid-cols-1 gap-5 px-2 md:grid-cols-3 lg:grid-cols-4"
>
  {
    storiesMapped.map((st) => (
      <a
        href={fullSlugToUri(st.full_slug)}
        data-astro-prefetch
        class="group relative overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-border transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:ring-h-700/50 reveal"
      >
        <div class="aspect-4/3 overflow-hidden bg-surface">
          {st.content.photo?.filename && (
            <Image
              class="h-full w-full object-fill transition duration-500 group-hover:scale-110"
              src={st.content.photo?.filename}
              alt={st.content?.name ?? ""}
              width={400}
              height={300}
              widths={[200, 300, 400]}
              sizes="(max-width: 768px) 80vw, (max-width: 1024px) 25vw, 20vw"
              transition:name={"partner-" + st.content._uid}
            />
          )}
        </div>
        <div class="flex flex-col items-center gap-1 px-4 py-4">
          <h2 class="text-center text-base font-extrabold text-h-900">{st.name}</h2>
          {st.content.role && <span class="tag-pill">{st.content.role}</span>}
        </div>
      </a>
    ))
  }
</section>
