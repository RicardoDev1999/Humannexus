---
import BaseLayout from "@layouts/BaseLayout.astro";

import "flowbite";

import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Toast from "@components/Toast.astro";
import Loading from "@components/Loading.astro";

import { useStoryblokApi } from "@storyblok/astro";
import { getStory } from "@scripts/astro/services";

let headerStory, footerStory;

const { context } = Astro.params;
const { forceContext } = Astro.props;

try {
  const storyblokApi = useStoryblokApi();
  headerStory = await getStory("header", storyblokApi, {}, forceContext || context);
} catch (error) {
  console.error(error);
  return Astro.redirect("/400");
}

try {
  const storyblokApi = useStoryblokApi();
  footerStory = await getStory("footer", storyblokApi, {}, forceContext || context);
} catch (error) {
  console.error(error);
  return Astro.redirect("/400");
}
---

<BaseLayout title={Astro.props.title}>
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
    slot="header"></script>
  <Header
    headerStory={headerStory}
    slot="beforeMain"
  />
  <Loading slot="beforeMain" />
  <Toast />
  <slot />
  <Footer
    footerStory={footerStory}
    slot="afterMain"
  />
  <script is:inline slot="afterMain">
    if (!window.__humannexusLoadingHandlers) {
      window.__humannexusLoadingHandlers = true;
      let loadingTimeout;

    const showLoading = () => {
      const loadingElement = document.querySelector("#loading");
      if (loadingElement) loadingElement.style.opacity = "1";
      if (loadingTimeout) clearTimeout(loadingTimeout);
      loadingTimeout = setTimeout(hideLoading, 10000);
    };

    const hideLoading = () => {
      if (loadingTimeout) clearTimeout(loadingTimeout);
      const loadingElement = document.querySelector("#loading");
      if (loadingElement) loadingElement.style.opacity = "0";
    };

    const applyContextColors = () => {
      const header = document.querySelector("[data-humannexus-colors]");
      if (!header) return;

      try {
        const colors = JSON.parse(header.getAttribute("data-humannexus-colors") || "{}");
        for (const [name, value] of Object.entries(colors)) {
          document.documentElement.style.setProperty(`--color-h-${name.replace("color", "")}`, value, "important");
        }
      } catch (error) {
        console.error("Unable to apply context colors", error);
      }
    };

    document.addEventListener("astro:before-preparation", showLoading);
    document.addEventListener("astro:after-preparation", hideLoading);
    document.addEventListener("astro:after-swap", applyContextColors);
    document.addEventListener("astro:page-load", () => {
      applyContextColors();
      hideLoading();
    });
    window.addEventListener("pageshow", () => {
      applyContextColors();
      hideLoading();
    });
    window.addEventListener("pagehide", () => {
      if (loadingTimeout) clearTimeout(loadingTimeout);
    });

      hideLoading();
      applyContextColors();
    }
  </script>
  <script
    src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"
    slot="afterMain"></script>
</BaseLayout>
