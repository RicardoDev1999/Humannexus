---
import BaseLayout from "@layouts/BaseLayout.astro";

import "flowbite";

import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Toast from "@components/Toast.astro";
import Loading from "@components/Loading.astro";

import { ViewTransitions } from "astro:transitions";

import { useStoryblokApi } from "@storyblok/astro";
import { getStory } from "@scripts/astro/services";

let headerStory, footerStory;

const { context } = Astro.params;
const { forceContext } = Astro.props;

try {
  const storyblokApi = useStoryblokApi();
  headerStory = await getStory("header", storyblokApi, {}, forceContext || context);
} catch (error) {
  console.error(error);
  return Astro.redirect("/400");
}

try {
  const storyblokApi = useStoryblokApi();
  footerStory = await getStory("footer", storyblokApi, {}, forceContext || context);
} catch (error) {
  console.error(error);
  return Astro.redirect("/400");
}
---

<BaseLayout title={Astro.props.title}>
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
    slot="header"></script>
  <ViewTransitions slot="header" />
  <Header
    headerStory={headerStory}
    transition:name="header"
    transition:persist
    slot="beforeMain"
  />
  <Loading slot="beforeMain" />
  <Toast />
  <slot />
  <Footer
    footerStory={footerStory}
    transition:name="footer"
    transition:persist
    slot="afterMain"
  />
  <script is:inline slot="afterMain">
    document.addEventListener("astro:before-preparation", () => {
      //Restart loading animation
      document.querySelector("#loading svg image").style.transform = null;
      document.querySelector("#loading").style.opacity = 100;
    });
    document.addEventListener("astro:after-preparation", () => {
      document.querySelector("#loading").style.opacity = 0;
    });
  </script>
  <script
    src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"
    slot="afterMain"></script>
</BaseLayout>
