---
import { useStoryblokApi } from "@storyblok/astro";
import { getStory } from "@scripts/astro/services";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

import Layout from "@layouts/Layout.astro";

const context = Astro.params.context;
const slug = Astro.params.slug === undefined ? "home" : Astro.params.slug;

let story;

try {
  const storyblokApi = useStoryblokApi();
  story = await getStory(slug, storyblokApi, {}, context);
} catch (error) {
  console.error(error);
  return Astro.redirect("/404");
}
---

<Layout title={story.name}>
  <StoryblokComponent blok={story.content} story={story} />
</Layout>
