---
import Layout from "@layouts/Layout.astro";

import { renderRichText, useStoryblokApi } from "@storyblok/astro";
import { getStory } from "@scripts/astro/services";

let story;

try {
  const storyblokApi = useStoryblokApi();
  story = await getStory("privacy-policy", storyblokApi);
} catch (error) {
  console.error(error);
  return Astro.redirect("/400");
}
---

<Layout title="Política de privacidade">
  <section class="flex flex-col justify-center items-center gap-y-3">
    <h1 class="text-h-800 text-center text-2xl font-bold">Política de privacidade</h1>
  </section>
  <section>
    <div
      class="max-w-full mx-8 prose prose-md lg:prose-lg prose-headings:text-h-800"
      set:html={renderRichText(story.content.content)}
    />
  </section>
</Layout>


