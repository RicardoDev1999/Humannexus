---
import Layout from "@layouts/Layout.astro";
import SectionIntro from "@components/SectionIntro.astro";

import { renderRichText, useStoryblokApi } from "@storyblok/astro";
import { getStory } from "@scripts/astro/services";

let story;

try {
  const storyblokApi = useStoryblokApi();
  story = await getStory("privacy-policy", storyblokApi);
} catch (error) {
  console.error(error);
  return Astro.redirect("/400");
}
---

<Layout title="Política de privacidade" forceContext="humannexus">
  <SectionIntro title="Política de privacidade" />
  <section class="mt-10 px-4">
    <div
      class="mx-auto max-w-3xl rounded-2xl border border-border bg-white p-6 shadow-sm prose prose-md lg:prose-lg prose-headings:text-h-900 prose-h4:text-xl prose-h4:mt-8 md:p-10"
      set:html={renderRichText(story.content.content)}
    />
  </section>
</Layout>


