---
import ContextLayout from "@layouts/ContextLayout.astro";
import VideoPlayer from "@/components/VideoPlayer.astro";
import { Image } from "astro:assets";

import { useStoryblokApi } from "@storyblok/astro";
import { getStory } from "@scripts/astro/services";

const { default: backgroundMovie } = await import(`/index.mp4?url`);

const { default: backgroundMovieThumbnailSmall } =
  await import("/index-thumb@0.5x.jpg?url");
const { default: backgroundMovieThumbnailMedium } =
  await import("/index-thumb.jpg?url");
const { default: backgroundMovieThumbnailLarge } =
  await import("/index-thumb@2x.jpg?url");

const { context } = Astro.params;

let sectionsMapped;

try {
  const storyblokApi = useStoryblokApi();
  const story = await getStory("index", storyblokApi, {}, context);

  sectionsMapped = structuredClone(story.content.sections);

  sectionsMapped.map((section) => {
    if (!section.image.filename) return section;

    section.image.filename =
      section.image.filename +
      "/m/fit-in/800x360/filters:format(webp):quality(100)";
    return section;
  });
} catch (error) {
  console.error(error);
  return Astro.redirect("/400");
}
---

<ContextLayout title="Início">
  <main
    class="relative isolate flex min-h-dvh w-full items-center overflow-hidden bg-h-900"
  >
    <div class="absolute inset-0 opacity-45">
      <VideoPlayer
        videoSrc={backgroundMovie}
        thumbnailSmall={backgroundMovieThumbnailSmall}
        thumbnailNormal={backgroundMovieThumbnailMedium}
        thumbnailLarge={backgroundMovieThumbnailLarge}
      />
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/40 to-black/70"
      aria-hidden="true"
    >
    </div>
    <section class="relative z-10 mx-auto w-full max-w-6xl px-4 py-16 md:px-8">
      <div class="reveal mx-auto mb-10 max-w-xl text-center md:mb-14">
        <span class="mx-auto mb-5 block h-1.5 w-14 rounded-full bg-gradient-to-r from-white/70 to-white" aria-hidden="true"></span>
        <h1 class="text-2xl font-extrabold tracking-tight text-white md:text-3xl">
          Escolha o seu espaço
        </h1>
        <p class="mt-3 text-sm font-medium text-white/80 md:text-base">
          Selecione a área da Humannexus que pretende visitar.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {
          sectionsMapped.map((section) => (
            <form action={section.href} method="post" data-astro-reload>
              <button
                type="submit"
                aria-label={section.name}
                class="group reveal flex w-full flex-col items-center gap-4 rounded-2xl border border-white/25 bg-white/95 p-6 shadow-xl backdrop-blur-sm transition duration-300 hover:-translate-y-1.5 hover:bg-white hover:shadow-2xl focus-visible:-translate-y-1.5"
              >
                {section.image?.filename && (
                  <Image
                    class="h-24 w-full object-contain transition duration-300 group-hover:scale-[1.03]"
                    loading={"eager"}
                    width="800"
                    height="360"
                    src={section.image?.filename}
                    alt=""
                  />
                )}
                <span class="text-sm font-bold text-h-900">{section.name}</span>
              </button>
            </form>
          ))
        }
      </div>
    </section>
  </main>
</ContextLayout>
