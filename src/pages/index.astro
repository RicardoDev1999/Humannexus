---
import ContextLayout from "@layouts/ContextLayout.astro";
import VideoPlayer from "@/components/VideoPlayer.astro";
import { Image } from "astro:assets";

import { useStoryblokApi } from "@storyblok/astro";
import { getStory } from "@scripts/astro/services";

const { default: backgroundMovie } = await import(`/index.mp4?url`);

const { default: backgroundMovieThumbnailSmall } = await import(
  "/index-thumb@0.5x.jpg?url"
);
const { default: backgroundMovieThumbnailMedium } = await import(
  "/index-thumb.jpg?url"
);
const { default: backgroundMovieThumbnailLarge } = await import(
  "/index-thumb@2x.jpg?url"
);

const { context } = Astro.params;

let sectionsMapped;

try {
  const storyblokApi = useStoryblokApi();
  const story = await getStory("index", storyblokApi, {}, context);

  sectionsMapped = structuredClone(story.content.sections);

  sectionsMapped.map((section) => {
    if (!section.image.filename) return section;

    section.image.filename =
      section.image.filename +
      "/m/fit-in/800x360/filters:format(webp):quality(100)";
    return section;
  });
} catch (error) {
  console.error(error);
  return Astro.redirect("/400");
}
---

<ContextLayout title="Início">
  <main
    class="relative bg-black flex flex-1 w-full h-full justify-center align-middle m-auto p-auto overflow-hidden"
  >
    <div class="opacity-40">
      <VideoPlayer
        videoSrc={backgroundMovie}
        thumbnailSmall={backgroundMovieThumbnailSmall}
        thumbnailNormal={backgroundMovieThumbnailMedium}
        thumbnailLarge={backgroundMovieThumbnailLarge}
      />
    </div>
    <section
      class="flex w-full h-full justify-center items-start m-auto pt-20 xl:flex-row flex-col gap-16 z-20"
    >
      {
        sectionsMapped.map((section) => (
          <div
            class="flex justify-center align-middle xl:m-0 mx-auto my-8 border-2 bg-[#ffffffbb] hover:bg-white border-[ffffffbb] rounded-2xl hover:scale-95 transition duration-850"
            aria-label={section.name}
          >
            <form action={section.href} method="post">
              <button
                type="submit"
                class="
                2xl:w-[28rem] 2xl:h-[10rem]
                xl:w-[21rem] xl:h-[8.5rem]
                md:w-[28rem] md:h-[10rem]
                w-[21rem] h-[8.5rem]
                hover:drop-shadow-2xl"
              >
                <Image
                  class="w-full h-full object-contain shadow-inner"
                  loading={"eager"}
                  width="800"
                  height="360"
                  src={section.image.filename}
                  alt={section.name}
                />
                {/* <span>{section.name}</span> */}
              </button>
            </form>
          </div>
        ))
      }
    </section>
  </main>
</ContextLayout>
